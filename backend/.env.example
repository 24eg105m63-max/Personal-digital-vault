# Copy this file to .env in this directory for local development.
# Use real deployment-specific values. Do not commit the resulting .env file.
DB_URL=jdbc:mysql://localhost:3306/personal_digital_vault
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
JWT_SECRET=YOUR_LONG_RANDOM_SECRET
JWT_EXPIRATION=86400000
SERVER_PORT=8080
ADMIN_USERNAME=admin@vault.local
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
