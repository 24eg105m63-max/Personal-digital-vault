# Copy this file to .env in this directory for local development.
# Use real deployment-specific values. Do not commit the resulting .env file.
DATABASE_URL=jdbc:mysql://localhost:3306/college_event_management?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=
ADMIN_NAME=Campus Administrator
ADMIN_PHONE=0000000000
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
UPLOAD_DIR=uploads
# Generate a random Base64-encoded 32-byte key for AES-256-GCM.
CREDENTIAL_ENCRYPTION_KEY=
